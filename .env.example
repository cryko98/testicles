# Meme Machine (/api/meme) — set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Required: fal.ai API key (https://fal.ai/dashboard/keys)
FAL_KEY=

# Strongly recommended: Upstash Redis for real rate limits across all serverless instances.
# Add "Upstash for Redis" from the Vercel Marketplace (it fills KV_REST_API_URL / KV_REST_API_TOKEN),
# or set the UPSTASH_ names yourself. Without it, limits are per instance (much weaker).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Limits (defaults shown). nano-banana/edit costs about $0.04 per image,
# so MEME_DAILY_CAP=150 means at most ~$6/day.
MEME_PER_HOUR=10
MEME_PER_DAY=30
MEME_DAILY_CAP=150

# Kill switch: set to 1 to turn the generator off instantly.
MEME_DISABLED=

# Optional overrides
# MEME_MODEL=fal-ai/nano-banana/edit
# MEME_REF_BASE=https://www.testiclesalwaysbounce.fun/meme/
